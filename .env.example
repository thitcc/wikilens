# WikiLens API keys — copy this file to `.env` and fill in the providers you use.
#
#   cp .env.example .env
#
# Notes:
# - Only the provider you actually select in the app needs a key.
# - Real OS environment variables take PRECEDENCE over values in `.env`.
# - `.env` is loaded on startup and works for `npm run tauri dev`. The packaged
#   app may not find it (its working directory is unpredictable) — use OS env
#   vars there (e.g. `setx ANTHROPIC_API_KEY "..."`).
# - `.env` is gitignored; never commit real keys.

# Anthropic (Claude)   — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# DeepSeek             — https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# OpenRouter           — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional per-provider model overrides (built-in defaults shown commented).
# Uncomment and change to point at a different model without editing code.
# WIKILENS_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# WIKILENS_DEEPSEEK_MODEL=deepseek-v4-flash
# WIKILENS_OPENROUTER_MODEL=openai/gpt-4o-mini

# Retrieval tuning (optional) — escape hatches for the retrieval pipeline; see
# the "Retrieval tuning (advanced)" table in README.md. All work out of the box
# when unset.
# Disable the LLM query rewrite (on by default; 0/false/off/no turn it off):
# WIKILENS_QUERY_REWRITE=0
# Pin the rewrite to a different model (default: the answer model) — pick a
# fast, non-reasoning one:
# WIKILENS_REWRITE_MODEL=claude-haiku-4-5-20251001
# Pin the rewrite to another configured provider (default: the answer provider;
# needs that provider's key). Your question text is then sent to that second
# vendor as well:
# WIKILENS_REWRITE_PROVIDER=anthropic
# Disable the last-resort fuzzy title match (on by default):
# WIKILENS_TITLE_INDEX=0
# Log each retrieval round as JSON on stderr for offline evaluation (off unless
# set — any value enables it):
# WIKILENS_TRACE_RETRIEVAL=1

# Debug instrumentation — set to 1/true to print a per-ask table to the
# terminal (stderr): phase timings, models, token counts, and queries — never
# wiki text or API keys. Off by default; 0/false/off/no also disable it.
# WIKILENS_DEBUG=true
