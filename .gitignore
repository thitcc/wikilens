# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Rust / Tauri build output (also ignored in src-tauri/.gitignore)
src-tauri/target

# Local env overrides (model pins, tuning vars, the eval suite's target). API
# keys live in the app's DPAPI store, never here — but keep .env out anyway.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Obsidian + Claudian: the whole `.obsidian/` and `.claudian/` trees are
# per-machine state (UI layout, themes, hotkeys, plugin code, Claudian sessions
# and settings) and never committed — open `vault/` as the Obsidian vault and
# let the apps regenerate them. The vault docs themselves stay tracked.
vault/.obsidian/
vault/.claudian/

# Codex skill adapters are generated locally from .claude/ by the sync-agents
# skill (node .claude/skills/sync-agents/generate.mjs) — never committed.
# Deliberately narrow: a stray root AGENTS.md (it would silently shadow
# CLAUDE.md) and anything else under .agents/ must stay visible in git status.
/.agents/skills/

# Per-machine Claude Code config: absolute paths and machine-local permission
# grants.
.claude/settings.local.json

# impeccable design-context: track the tokens (design.json, live/config.json);
# critique/ snapshots and live-session journals are per-session working notes,
# never committed.
.impeccable/critique/
.impeccable/live/sessions/

# Retrieval eval run output (eval/run-*.mjs): raw JSONL per round, answers,
# judge verdicts — local measurement data; summaries go in the vault.
eval/out/

# Tool runtime state that reappears in any clone (Claude Code scheduling /
# agent files, impeccable hook caches and live sessions) — machine-local and
# full of absolute paths; ignored here rather than in .git/info/exclude so a
# fresh checkout can never `git add -A` them.
**/.claude/scheduled_tasks.lock
**/.claude/scheduled_tasks.json
**/.claude/routines/.state/
**/.claude/worktrees/
**/.claude/checkpoints/
**/.claude/mailbox/
**/.claude/agent-registry.json
**/.claude/agent-memory-local
**/.claude/first-run
**/.claude/assistant-daemon-state.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/config.local.json
.impeccable/live/server.json
.impeccable/live/previews/
.impeccable/live/annotations/
.impeccable/live/cache/
.impeccable/live/manual-edit-*
.impeccable/live/pending-manual-edits.json
.impeccable/live/deferred-svelte-component-accepts.json
.impeccable-live.json
.impeccable-live/
