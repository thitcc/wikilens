# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Rust / Tauri build output (also ignored in src-tauri/.gitignore)
src-tauri/target

# Secrets — never commit provider API keys (.env holds the ANTHROPIC / DEEPSEEK / OPENROUTER keys)
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Obsidian: track the config JSON (app / appearance / community-plugins / …) so the
# vault is reproducible, but ignore per-machine UI state and third-party plugin code.
vault/.obsidian/workspace.json
vault/.obsidian/workspace-mobile.json
vault/.obsidian/cache
vault/.obsidian/plugins/

# Codex skill adapters are generated locally from .claude/ by the sync-agents
# skill (node .claude/skills/sync-agents/generate.mjs) — never committed.
# Deliberately narrow: a stray root AGENTS.md (it would silently shadow
# CLAUDE.md) and anything else under .agents/ must stay visible in git status.
/.agents/skills/

# Per-machine Claude Code config: absolute paths and machine-local permission
# grants.
.claude/settings.local.json

# impeccable design-context: track the tokens (design.json, live/config.json);
# critique/ snapshots and live-session journals are per-session working notes,
# never committed.
.impeccable/critique/
.impeccable/live/sessions/
